{
  "manifest_version": 3,
  "name": "Resume Agent: Should I Apply?",
  "version": "1.6.0",
  "description": "Scores the job posting you are looking at against your resume and tells you whether to apply.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Should I Apply?"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extract.js",
        "autofill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
